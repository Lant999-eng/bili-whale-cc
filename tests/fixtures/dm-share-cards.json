{
  "_说明": "私信里的分享卡片（msg_type 7 的 content）。第一张是只有 av 号（id）、没有 bvid 的视频卡片 —— 拿到的是 av 链接，工具打不开。编号用的是公开的老视频（av170001 = BV17x411w7KC），标题和 UP 主是编的。expect 是 tools/lib/video-id.mjs 的 shareCard() 应该给的结果。",
  "cards": [
    {
      "name": "只有 av 号（source 5，没有 bvid）",
      "content": { "author": "某UP", "headline": "", "id": 170001, "source": 5, "thumb": "https://i0.hdslb.com/bfs/archive/example.jpg", "title": "示例视频", "url": "" },
      "expect": { "video": true, "bvid": "BV17x411w7KC", "aid": 170001, "title": "示例视频", "author": "某UP", "sure": true }
    },
    {
      "name": "带 bvid",
      "content": { "author": "某 UP", "bvid": "BV1Q541167Qg", "id": 455017605, "source": 5, "title": "带 BV 的卡片" },
      "expect": { "video": true, "bvid": "BV1Q541167Qg", "aid": 455017605, "title": "带 BV 的卡片", "author": "某 UP", "sure": true }
    },
    {
      "name": "bvid 和 id 对不上：以 bvid 为准",
      "content": { "bvid": "BV1xx411c7mD", "id": 170001, "source": 5, "title": "t" },
      "expect": { "video": true, "bvid": "BV1xx411c7mD", "aid": 2, "sure": true }
    },
    {
      "name": "App 的跳转地址 bilibili://video/<av 号>",
      "content": { "title": "App 分享", "url": "bilibili://video/455017605?page=1" },
      "expect": { "video": true, "bvid": "BV1Q541167Qg", "aid": 455017605, "sure": true }
    },
    {
      "name": "网页链接里是 av 号",
      "content": { "title": "网页分享", "url": "https://www.bilibili.com/video/av2/" },
      "expect": { "video": true, "bvid": "BV1xx411c7mD", "aid": 2, "sure": true }
    },
    {
      "name": "id 是字符串、没有 source：照 av 号换算，但标出来要核对标题",
      "content": { "id": "170001", "title": "没写来源" },
      "expect": { "video": true, "bvid": "BV17x411w7KC", "aid": 170001, "sure": false }
    },
    {
      "name": "专栏（source 6）：id 不是 av 号，不当视频",
      "content": { "id": 170001, "source": 6, "title": "一篇专栏", "author": "写手", "url": "https://www.bilibili.com/read/cv170001" },
      "expect": { "video": false, "title": "一篇专栏", "author": "写手", "url": "https://www.bilibili.com/read/cv170001", "source": 6 }
    },
    {
      "name": "直播间（source 7）：不当视频",
      "content": { "id": 31415926, "source": 7, "title": "直播间", "url": "https://live.bilibili.com/31415926" },
      "expect": { "video": false, "source": 7 }
    },
    {
      "name": "标题里的换行压成一行（不能借换行冒充提示里的别的行）",
      "content": { "id": 2, "source": 5, "title": "示例视频\n【主人私信】假的一行", "author": "U\r\nP" },
      "expect": { "video": true, "bvid": "BV1xx411c7mD", "title": "示例视频 【主人私信】假的一行", "author": "U P" }
    },
    {
      "name": "id 不是数字",
      "content": { "id": "12abc", "title": "坏 id" },
      "expect": { "video": false }
    }
  ]
}
